{
  "workdir": null,
  "datasets": {
    "human_dna": {
      "alphabet": "dna",
      "raw": "data/raw/human_dna.csv",
      "format": "csv"
    },
    "coronavirus_host": {
      "alphabet": "protein",
      "raw": "data/raw/coronavirus_host.csv",
      "format": "csv"
    },
    "spike7k": {
      "alphabet": "protein",
      "raw": "data/raw/spike7k.csv",
      "format": "csv"
    }
  },
  "compressors": [
    "gzip",
    "bz2",
    "lzma"
  ],
  "n_seeds": 10,
  "split_fractions": [
    0.6,
    0.1,
    0.3
  ],
  "cluster_thresholds": {
    "dna": [
      0.5,
      0.8,
      0.95
    ],
    "protein": [
      0.3,
      0.5,
      0.9,
      0.99
    ]
  },
  "cluster_coverage": 0.8,
  "ncd_row_chunk": 150,
  "ncd_processes": 8,
  "kernel": {
    "sigma2_multipliers": [
      0.1,
      0.5,
      1.0,
      2.0,
      5.0
    ],
    "n_components": [
      16,
      32,
      64,
      128,
      256
    ],
    "selection_classifier": "LR",
    "selection_metric": "macro_f1"
  },
  "classifiers": [
    "SVM",
    "NB",
    "MLP",
    "KNN",
    "RF",
    "LR",
    "DT"
  ],
  "permutation_null_n": 200,
  "foundation_models": {
    "protein": [
      "esm2_650m",
      "prott5_xl_u50"
    ],
    "dna": [
      "nt_v2_500m"
    ]
  },
  "cpu_timing_n_sequences": 100
}